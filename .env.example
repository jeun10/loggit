# PostgreSQL (docker-compose, backend local profile)
DB_NAME=loggit
DB_USERNAME=loggit
DB_PASSWORD=

# 필요할 때만 변경 (기본값: local)
# SPRING_PROFILES_ACTIVE=prod
# LOGGIT_ENV_FILE=/etc/loggit/loggit.env

# JWT 서명 키 (HS256, 32바이트 이상 랜덤 문자열)
JWT_SECRET=

# GitHub OAuth (미구현, 추후 사용)
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# 저장된 GitHub 토큰 암호화 키 (미구현, 추후 사용)
TOKEN_ENCRYPTION_KEY=

# Gemini 요약 (미구현, 추후 사용)
GEMINI_API_KEY=
